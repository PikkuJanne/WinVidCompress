{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WinVidCompress product metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "product_id", "name", "summary", "source_repository", "processing_location", "uploads_supported", "reviewed_default_profile", "candidate", "requirements", "tested_platforms", "setup", "privacy", "links", "published_version", "release_date", "release_url", "download_url", "sha256", "screenshots", "measured_examples", "known_limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["draft_not_for_publication", "published"]},
    "product_id": {"const": "winvidcompress"},
    "name": {"const": "WinVidCompress"},
    "summary": {"type": "string", "minLength": 1},
    "source_repository": {"const": "https://github.com/PikkuJanne/WinVidCompress"},
    "processing_location": {"const": "user_device"},
    "uploads_supported": {"const": false},
    "reviewed_default_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["video", "preset", "crf", "pixel_format", "audio", "audio_bitrate", "container", "faststart", "oriented_height_cap", "crop", "upscale", "output_layout"],
      "properties": {
        "video": {"const": "libx264"}, "preset": {"const": "veryfast"}, "crf": {"const": 22},
        "pixel_format": {"const": "yuv420p"}, "audio": {"const": "aac"}, "audio_bitrate": {"const": "160k"},
        "container": {"const": "mp4"}, "faststart": {"const": true}, "oriented_height_cap": {"const": 1080},
        "crop": {"const": false}, "upscale": {"const": false}, "output_layout": {"const": "flat"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "status", "source_commit", "application_sha256", "launcher_sha256", "evidence"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-rc\\.[0-9]+)?$"},
        "status": {"const": "unpublished_candidate"},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "application_sha256": {"$ref": "#/definitions/digest"}, "launcher_sha256": {"$ref": "#/definitions/digest"},
        "evidence": {"$ref": "#/definitions/strings"}
      }
    },
    "requirements": {"$ref": "#/definitions/strings"},
    "tested_platforms": {"$ref": "#/definitions/strings"},
    "setup": {"$ref": "#/definitions/strings"},
    "privacy": {"$ref": "#/definitions/strings"},
    "links": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "license", "support", "security", "changelog", "instructions", "verification", "ffmpeg_download", "ffmpeg_license"],
      "properties": {
        "source": {"type": "string"}, "license": {"type": "string"}, "support": {"type": "string"},
        "security": {"type": "string"}, "changelog": {"type": "string"}, "instructions": {"type": "string"},
        "verification": {"type": "string"}, "ffmpeg_download": {"const": "https://ffmpeg.org/download.html"},
        "ffmpeg_license": {"const": "https://ffmpeg.org/legal.html"}
      }
    },
    "published_version": {"type": ["null", "string"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "not": {"type": "string", "pattern": "\\s"}},
    "release_date": {"type": ["null", "string"], "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"},
    "release_url": {"type": ["null", "string"], "pattern": "^https://github\\.com/PikkuJanne/WinVidCompress/releases/tag/v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "download_url": {"type": ["null", "string"], "pattern": "^https://github\\.com/PikkuJanne/WinVidCompress/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/WinVidCompress-[0-9]+\\.[0-9]+\\.[0-9]+\\.zip$"},
    "sha256": {"type": ["null", "string"], "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
    "screenshots": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["file", "sha256", "alt", "caption", "source_commit", "capture_method", "redactions"],
        "properties": {
          "file": {"type": "string", "pattern": "^screenshots/[a-z0-9-]+\\.png$"}, "sha256": {"$ref": "#/definitions/digest"},
          "alt": {"type": "string", "minLength": 1}, "caption": {"type": "string", "minLength": 1},
          "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "capture_method": {"const": "actual_window_capture"}, "redactions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "measured_examples": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["file", "sha256", "label", "scope"],
        "properties": {
          "file": {"type": "string", "pattern": "^examples/[a-z0-9-]+\\.json$"}, "sha256": {"$ref": "#/definitions/digest"},
          "label": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}
        }
      }
    },
    "known_limitations": {"$ref": "#/definitions/strings"}
  },
  "definitions": {
    "digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
    "strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "draft_not_for_publication"}}},
      "then": {"properties": {"published_version": {"type": "null"}, "release_date": {"type": "null"}, "release_url": {"type": "null"}, "download_url": {"type": "null"}, "sha256": {"type": "null"}}},
      "else": {"properties": {"published_version": {"type": "string"}, "release_date": {"type": "string"}, "release_url": {"type": "string"}, "download_url": {"type": "string"}, "sha256": {"type": "string"}, "screenshots": {"minItems": 1}}}
    }
  ]
}
