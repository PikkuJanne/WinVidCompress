    {
      "Id": "sdr-av",
      "File": "sdr-av.mp4",
      "Kind": "Media",
      "Provenance": "Runtime synthetic lavfi signals; no source footage.",
      "CleanupOwner": "New-WvcTestRoot token; Remove-WvcTestRoot",
      "Requires": [
        "ffmpeg",
        "ffprobe"
      ],
      "RequiredCapabilities": [
        "lavfi",
        "sine",
        "testsrc2",
        "libx264",
        "mp4 muxer",
        "aac"
      ],
      "Arguments": [
        "-nostdin",
        "-hide_banner",
        "-loglevel",
        "error",
        "-n",
        "-f",
        "lavfi",
        "-i",
        "testsrc2=size=320x240:rate=24:duration=1",
        "-f",
        "lavfi",
        "-i",
        "sine=frequency=440:sample_rate=48000:duration=1",
        "-t",
        "1",
        "-map",
        "0:v:0",
        "-map",
        "1:a:0",
        "-c:v",
        "libx264",
        "-preset",
        "veryfast",
        "-crf",
        "22",
        "-pix_fmt",
        "yuv420p",
        "-c:a",
        "aac",
        "-b:a",
        "160k",
        "-movflags",
        "+faststart",
        "{output}"
      ],
      "ProbeArguments": [
        "-v",
        "error",
        "-show_streams",
        "-show_format",
        "-of",
        "json",
        "{output}"
      ],
      "ExpectedStreams": [
        {
          "codec_type": "video",
          "codec_name": "h264",
          "width": 320,
          "height": 240,
          "pix_fmt": "yuv420p"
        },
        {
          "codec_type": "audio",
          "codec_name": "aac",
          "sample_rate": "48000",
          "channels": 1
        }
      ],
      "DurationSeconds": {
        "Minimum": 0.8,
        "Maximum": 1.5
      },
      "Capabilities": [
        "small video with mono audio",
        "height below cap",
        "unclassified SDR pixel format"
      ]
    },
